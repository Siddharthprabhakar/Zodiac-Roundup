{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zodiac-roundup-game",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "r2_buckets": [
    {
      "binding": "GAME_BUCKET",
      "bucket_name": "zodiac-roundup-webgl"
    }
  ],
  "observability": {
    "enabled": true
  }
}
